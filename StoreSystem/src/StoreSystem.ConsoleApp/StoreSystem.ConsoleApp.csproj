    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>StoreSystem</AssemblyName>
    <RootNamespace>StoreSystem</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\StoreSystem.Domain\StoreSystem.Domain.csproj" />
    <ProjectReference Include="..\StoreSystem.Data\StoreSystem.Data.csproj" />
    <ProjectReference Include="..\StoreSystem.Business\StoreSystem.Business.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
